# Скопируй в .env (он в .gitignore) и впиши ключи сам. В чат и в код ключи не вставлять.
# Агент читает только переменные окружения; на судействе организаторы задают только OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=
# Модели: дешёвая для объяснения плана, сильная — для пульта аналитика
OPENAI_MODEL_FAST=gpt-5.6-luna
OPENAI_MODEL_SMART=gpt-5.6-terra
# ИИ-объяснение плана в workflow.py: 1 — вызывать модель, 0 — шаблонное объяснение (по умолчанию)
AGENT_LLM=0
# Лимиты вызова: усилие, таймаут, ответ, попытки на ключ, бюджет запуска в USD (проверяется ДО запроса)
AGENT_LLM_REASONING_EFFORT=low
AGENT_LLM_TIMEOUT_SECONDS=30
AGENT_LLM_MAX_OUTPUT_TOKENS=2000
AGENT_LLM_MAX_ATTEMPTS=2
AGENT_LLM_RUN_BUDGET_USD=0.05
# Цены USD за 1 млн токенов (вход/выход); если не заданы — встроенная таблица официальных цен OpenAI
AGENT_LLM_PRICE_INPUT_PER_1M=
AGENT_LLM_PRICE_OUTPUT_PER_1M=
