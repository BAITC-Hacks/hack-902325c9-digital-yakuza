APP_NAME=Hackathon API
APP_ENV=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://hackathon:local-dev-password@postgres:5432/hackathon
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
OPENAI_API_KEY=
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=
AGENT_LLM=1
OPENAI_MODEL_FAST=gpt-5.6-luna
AGENT_LLM_RUN_BUDGET_USD=0.05
AGENT_LLM_TIMEOUT_SECONDS=30
AGENT_LLM_MAX_ATTEMPTS=2
AGENT_LLM_MAX_OUTPUT_TOKENS=2000
BEELINE_AGENT_DIR=beeline_agent

POSTGRES_DB=hackathon
POSTGRES_USER=hackathon
POSTGRES_PASSWORD=local-dev-password
